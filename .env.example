# Gemini AI API Key (Get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Channel 1: Live Breaking News Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_news_telegram_chat_id_here
ENABLE_TELEGRAM_ALERTS=true

# Channel 2: Market Calendar & Outcomes Telegram Alerts (Separate Group/Channel)
# Leave CALENDAR_TELEGRAM_BOT_TOKEN blank to reuse TELEGRAM_BOT_TOKEN
CALENDAR_TELEGRAM_BOT_TOKEN=
CALENDAR_TELEGRAM_CHAT_ID=your_calendar_telegram_chat_id_here
ENABLE_CALENDAR_ALERTS=true

# WhatsApp Alerts (Optional - Choose one method)
ENABLE_WHATSAPP_ALERTS=false
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=
WHATSAPP_WEBHOOK_URL=
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_ID=

# Scraper Settings
REFRESH_INTERVAL=1
ENABLE_AI_SCORING=true
ALERT_THRESHOLD=75
PORT=7860
