# Gemini AI API Key (Get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ENABLE_TELEGRAM_ALERTS=true

# WhatsApp Alerts (Optional - Choose one method)
ENABLE_WHATSAPP_ALERTS=false
# Option 1: Webhook (Green API, Zapier, Make, Evolution API, Custom Bot)
WHATSAPP_WEBHOOK_URL=
# Option 2: Free CallMeBot API
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Option 3: Meta Official Cloud API
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_ID=

# Scraper Settings
REFRESH_INTERVAL=5
ENABLE_AI_SCORING=true
ALERT_THRESHOLD=75
PORT=7860
